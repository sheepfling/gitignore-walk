{
  "schema_version": 1,
  "source": "vcs-ignore-implementation-research.zip and isolated local P4 client/server probes",
  "cases": [
    {
      "id": "p4.newline-filename-rejected-before-ignore-evaluation",
      "dimension": "path-boundary",
      "setup": {
        "P4IGNORE": ".p4ignore",
        "files": {
          ".p4ignore": "*.tmp\n"
        }
      },
      "query": "notes\narchive.tmp",
      "expected_candidate": null,
      "expected_native_error": "Non-printable characters not allowed",
      "evidence_status": "native-observed",
      "native_status": "captured",
      "release_gate": "Record the native path rejection without treating it as an ignore-rule mismatch."
    },
    {
      "id": "p4.p4config-discovers-ignore-source",
      "dimension": "configuration-discovery",
      "setup": {
        "P4CONFIG": ".p4config",
        "files": {
          ".p4config": "P4IGNORE=custom.ignore\n",
          "custom.ignore": "*.tmp\n"
        }
      },
      "query": "build/a.tmp",
      "query_cwd": "parent",
      "expected_candidate": true,
      "evidence_status": "native-observed",
      "native_status": "captured",
      "release_gate": "Capture P4IGNORE inherited from an isolated P4CONFIG file on all available profiles."
    },
    {
      "id": "p4.p4config-ignore-overrides-environment",
      "dimension": "configuration-precedence",
      "setup": {
        "P4CONFIG": ".p4config",
        "P4IGNORE": "environment.ignore",
        "files": {
          ".p4config": "P4IGNORE=config.ignore\n",
          "config.ignore": "*.tmp\n",
          "environment.ignore": ""
        }
      },
      "query": "a.tmp",
      "expected_candidate": true,
      "evidence_status": "native-observed",
      "native_status": "captured",
      "release_gate": "Confirm that P4CONFIG P4IGNORE overrides the process environment value."
    },
    {
      "id": "p4.nested-p4config-selects-nested-ignore-source",
      "dimension": "configuration-scope",
      "setup": {
        "P4CONFIG": ".p4config",
        "files": {
          ".p4config": "P4IGNORE=root.ignore\n",
          "root.ignore": "*.tmp\n",
          "sub/.p4config": "P4IGNORE=child.ignore\n",
          "sub/child.ignore": "!*.tmp\n"
        }
      },
      "query": "sub/a.tmp",
      "query_cwd": "parent",
      "expected_candidate": false,
      "evidence_status": "native-observed",
      "native_status": "captured",
      "release_gate": "Determine whether a nested P4CONFIG replaces or supplements parent P4IGNORE configuration."
    },
    {
      "id": "p4.walk-exception-keeps-parent-traversable",
      "dimension": "traversal",
      "setup": {
        "files": {
          ".p4ignore": "build/\n!build/keep.txt\n*.log\n",
          "build/drop.txt": "ignored\n",
          "build/keep.txt": "exception\n",
          "build/nested/debug.log": "ignored\n",
          "notes.txt": "included\n",
          "notes/debug.log": "ignored\n"
        }
      },
      "query": "build/keep.txt",
      "expected_candidate": false,
      "capture_walk": true,
      "evidence_status": "native-observed",
      "native_status": "captured",
      "release_gate": "Compare recursive P4 add preview with included/ignored policy walks in both directions."
    },
