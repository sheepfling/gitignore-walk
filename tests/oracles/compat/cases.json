{
  "schema_version": 1,
  "source": "vcs-ignore-implementation-research.zip and isolated Sapling/Jujutsu mode probes",
  "probe_files": {
    ".gitignore": "*.tmp\n!local.priority\n",
    ".hgignore": "syntax: glob\n*.log\n",
    ".jjignore": "*.log\n",
    "a.tmp": "tmp\n",
    "b.log": "log\n",
    "visible.txt": "visible\n"
  },
  "query_files": ["a.tmp", "b.log", "visible.txt"],
  "expected_included": ["b.log", "visible.txt"],
  "expected_ignored": ["a.tmp"],
  "source_probe_files": {
    "global.global": "global ignore probe\n",
    "local.local": "repository-local ignore probe\n",
    "priority.global": "global and repository-local info override probe\n",
    "info.priority": "repository-local and workspace override probe\n",
    "local.priority": "workspace override probe\n"
  },
  "source_query_files": [
    "global.global",
    "local.local",
    "priority.global",
    "info.priority",
    "local.priority"
  ],
  "source_rules": {
    "xdg_git_ignore": "*.global\n",
    "git_info_exclude": "*.local\n!priority.global\ninfo.priority\nlocal.priority\n",
    "core_excludes_file": "*.custom\n",
    "system_core_excludes_file": "*.system\n"
  },
  "configured_global_probe_files": {
    "configured.global": "must be excluded by XDG default only\n",
    "configured.custom": "must be excluded by core.excludesFile\n",
    "configured.system": "must be excluded by system core.excludesFile only\n",
    "configured.visible": "must remain visible\n"
  },
  "expected_configured_global_ignored": {
    "sapling.git-mode": ["configured.custom"],
    "sapling.sl-mode": [],
    "jj.colocated": ["configured.custom"],
    "jj.noncolocated": ["configured.custom"]
  },
  "configured_system_probe_files": {
    "system.custom": "must be visible without global core.excludesFile\n",
    "system.system": "must be excluded by system core.excludesFile\n",
    "system.visible": "must remain visible\n"
  },
  "expected_configured_system_ignored": {
    "sapling.git-mode": ["system.system"],
    "sapling.sl-mode": [],
    "jj.colocated": ["system.system"],
    "jj.noncolocated": ["system.system"]
  },
  "conditional_global_probe_files": {
    "conditional.custom": "must be ignored only by a matching gitdir include\n",
    "conditional.global": "must be ignored by XDG when no include condition matches\n",
    "conditional.visible": "must remain visible\n"
  },
  "expected_conditional_global_ignored": {
    "sapling.git-mode": ["conditional.custom"],
    "sapling.sl-mode": [],
    "jj.colocated": ["conditional.custom"],
    "jj.noncolocated": []
  },
  "conditional_branch_probe_files": {
    "conditional.branch": "must be ignored only by a matching onbranch include\n",
    "conditional.global": "must be ignored by XDG when no include condition matches\n",
    "conditional.visible": "must remain visible\n"
  },
  "conditional_branch_ignore": "*.branch\n",
  "expected_conditional_branch_ignored": {
    "sapling.git-mode": ["conditional.branch"],
    "sapling.sl-mode": [],
    "jj.colocated": ["conditional.branch"],
    "jj.noncolocated": ["conditional.branch"]
  },
  "expected_source_ignored": {
    "sapling.git-mode": ["global.global", "info.priority", "local.local"],
    "sapling.sl-mode": [],
    "jj.colocated": ["global.global", "info.priority", "local.local"],
    "jj.noncolocated": ["global.global", "priority.global"]
  },
  "pattern_probe_files": {
    "blocked/keep.txt": "ignored parent blocks re-inclusion\n",
    "cache/drop.tmp": "ignored child\n",
    "cache/keep.tmp": "re-included child\n",
    "root-only.tmp": "root-anchored match\n",
    "nested/root-only.tmp": "nested root-anchored control\n",
    "nested/deep/deep.log": "recursive double-star match\n"
  },
  "pattern_rules": "blocked/\n!blocked/keep.txt\ncache/*\n!cache/keep.tmp\n/root-only.tmp\n**/deep.log\n",
  "pattern_query_files": [
    "blocked/keep.txt",
    "cache/drop.tmp",
    "cache/keep.tmp",
    "root-only.tmp",
    "nested/root-only.tmp",
    "nested/deep/deep.log"
  ],
  "expected_pattern_ignored": [
    "blocked/keep.txt",
    "cache/drop.tmp",
    "nested/deep/deep.log",
    "root-only.tmp"
  ],
  "profiles": [
    {"id": "sapling.git-mode", "vcs": "sapling", "mode": "git"},
    {"id": "sapling.sl-mode", "vcs": "sapling", "mode": "sl"},
    {"id": "jj.colocated", "vcs": "jujutsu", "mode": "colocated"},
    {"id": "jj.noncolocated", "vcs": "jujutsu", "mode": "noncolocated"}
  ]
}
