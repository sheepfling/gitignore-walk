{
  "schema_version": 1,
  "source": "vcs-ignore-implementation-research.zip and isolated Sapling/Jujutsu mode probes",
  "probe_files": {
    ".gitignore": "*.tmp\n!local.priority\n",
    ".hgignore": "syntax: glob\n*.log\n",
    ".jjignore": "*.log\n",
    "a.tmp": "tmp\n",
    "b.log": "log\n",
    "visible.txt": "visible\n"
  },
  "query_files": ["a.tmp", "b.log", "visible.txt"],
  "expected_included": ["b.log", "visible.txt"],
  "expected_ignored": ["a.tmp"],
  "source_probe_files": {
    "global.global": "global ignore probe\n",
    "local.local": "repository-local ignore probe\n",
    "priority.global": "global and repository-local info override probe\n",
    "info.priority": "repository-local and workspace override probe\n",
    "local.priority": "workspace override probe\n"
  },
  "source_query_files": [
    "global.global",
    "local.local",
    "priority.global",
    "info.priority",
    "local.priority"
  ],
  "source_rules": {
    "xdg_git_ignore": "*.global\n",
    "git_info_exclude": "*.local\n!priority.global\ninfo.priority\nlocal.priority\n"
  },
  "expected_source_ignored": {
    "sapling.git-mode": ["global.global", "info.priority", "local.local"],
    "sapling.sl-mode": [],
    "jj.colocated": ["global.global", "info.priority", "local.local"],
    "jj.noncolocated": ["global.global", "priority.global"]
  },
  "pattern_probe_files": {
    "blocked/keep.txt": "ignored parent blocks re-inclusion\n",
    "cache/drop.tmp": "ignored child\n",
    "cache/keep.tmp": "re-included child\n",
    "root-only.tmp": "root-anchored match\n",
    "nested/root-only.tmp": "nested root-anchored control\n",
    "nested/deep/deep.log": "recursive double-star match\n"
  },
  "pattern_rules": "blocked/\n!blocked/keep.txt\ncache/*\n!cache/keep.tmp\n/root-only.tmp\n**/deep.log\n",
  "pattern_query_files": [
    "blocked/keep.txt",
    "cache/drop.tmp",
    "cache/keep.tmp",
    "root-only.tmp",
    "nested/root-only.tmp",
    "nested/deep/deep.log"
  ],
  "expected_pattern_ignored": [
    "blocked/keep.txt",
    "cache/drop.tmp",
    "nested/deep/deep.log",
    "root-only.tmp"
  ],
  "profiles": [
    {"id": "sapling.git-mode", "vcs": "sapling", "mode": "git"},
    {"id": "sapling.sl-mode", "vcs": "sapling", "mode": "sl"},
    {"id": "jj.colocated", "vcs": "jujutsu", "mode": "colocated"},
    {"id": "jj.noncolocated", "vcs": "jujutsu", "mode": "noncolocated"}
  ]
}
