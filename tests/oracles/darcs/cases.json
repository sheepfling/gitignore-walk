{
  "schema_version": 1,
  "source": "vcs-ignore-implementation-research.zip and isolated Darcs 2 native probes",
  "cases": [
    {
      "id": "darcs.ere-alternation",
      "dimension": "regex",
      "setup": {
        "local_boring": "\\.(o|pyc)$\n"
      },
      "query": "x.pyc",
      "expected_boring": true,
      "native_status": "captured"
    },
    {
      "id": "darcs.posix-character-class",
      "dimension": "regex",
      "setup": {
        "local_boring": "^[[:digit:]]+$\n"
      },
      "query": "123",
      "expected_boring": true,
      "native_status": "captured"
    },
    {
      "id": "darcs.boringfile-replaces-local",
      "dimension": "discovery",
      "setup": {
        "local_boring": "\\.tmp$\n",
        "boringfile": "policy",
        "files": {
          "policy": "\\.bak$\n"
        }
      },
      "query": "a.tmp",
      "expected_boring": true,
      "native_status": "captured",
      "note": "Darcs 2.18.4 and 2.18.5 keep the local rule active despite docs saying it is replaced."
    },
    {
      "id": "darcs.boringfile-selects-versioned-source",
      "dimension": "discovery",
      "setup": {
        "local_boring": "\\.tmp$\n",
        "boringfile": "policy",
        "files": {
          "policy": "\\.bak$\n"
        }
      },
      "query": "a.bak",
      "expected_boring": true,
      "native_status": "captured"
    },
    {
      "id": "darcs.global-additive",
      "dimension": "discovery",
      "setup": {
        "local_boring": "",
        "global_boring": "\\.tmp$\n"
      },
      "query": "a.tmp",
      "expected_boring": true,
      "native_status": "captured"
    },
    {
      "id": "darcs.global-remains-active-with-local-rules",
      "dimension": "discovery",
      "setup": {
        "local_boring": "\\.local$\n",
        "global_boring": "\\.global$\n"
      },
      "query": "a.global",
      "expected_boring": true,
      "native_status": "captured",
      "note": "The global boring source remains active alongside a non-matching repository-local rule."
    },
    {
      "id": "darcs.global-remains-active-with-configured-boringfile",
      "dimension": "discovery",
      "setup": {
        "local_boring": "\\.local$\n",
        "global_boring": "\\.global$\n",
        "boringfile": "policy",
        "files": {
          "policy": "\\.configured$\n"
        }
      },
      "query": "a.global",
      "expected_boring": true,
      "native_status": "captured",
      "note": "The global boring source remains active when a configured repository boringfile is also selected."
    },
    {
      "id": "darcs.tracked-boring-file-remains-managed",
      "dimension": "membership",
      "setup": {
        "local_boring": "\\.tmp$\n",
        "tracked": [
          "a.tmp"
        ]
      },
      "query": "a.tmp",
      "expected_boring": false,
      "native_status": "captured"
    },
    {
      "id": "darcs.nested-repository-file-remains-an-outer-add-candidate",
      "dimension": "walking",
      "setup": {
        "local_boring": "",
        "nested_repositories": ["nested"],
        "files": {
          "nested/inner.txt": "nested repository file\n"
        }
      },
      "query": "nested/inner.txt",
      "expected_boring": false,
      "native_status": "captured",
      "note": "Outer Darcs whatsnew still reports files inside a nested Darcs repository as add candidates."
    },
    {
      "id": "darcs.hash-leading-rule-is-comment",
      "dimension": "lexing",
      "setup": {
        "local_boring": "#literal\n"
      },
      "query": "#literal",
      "expected_boring": false,
      "native_status": "captured"
    },
    {
      "id": "darcs.leading-space-is-rule-data",
      "dimension": "lexing",
      "setup": {
        "local_boring": " #literal\n"
      },
      "query": "#literal",
      "expected_boring": false,
      "native_status": "captured"
    },
    {
      "id": "darcs.trailing-space-is-rule-data",
      "dimension": "lexing",
      "setup": {
        "local_boring": "literal \n"
      },
      "query": "literal",
      "expected_boring": false,
      "native_status": "captured"
    },
    {
      "id": "darcs.trailing-tab-is-rule-data",
      "dimension": "lexing",
      "setup": {
        "local_boring": "literal\t\n"
      },
      "query": "literal",
      "expected_boring": false,
      "native_status": "captured"
    },
    {
      "id": "darcs.inline-hash-is-pattern-data",
      "dimension": "lexing",
      "setup": {
        "local_boring": "literal#suffix\n"
      },
      "query": "literal",
      "expected_boring": false,
      "native_status": "captured"
    },
    {
      "id": "darcs.unicode-literal-match",
      "dimension": "encoding",
      "setup": {
        "local_boring": "^\u00e9\\.tmp$\n"
      },
      "query": "\u00e9.tmp",
      "expected_boring": true,
      "native_status": "captured"
    },
    {
      "id": "darcs.unicode-normalization-is-distinct",
      "dimension": "encoding",
      "setup": {
        "local_boring": "^\u00e9\\.tmp$\n"
      },
      "query": "e\u0301.tmp",
      "expected_boring": false,
      "native_status": "captured"
    },
    {
      "id": "darcs.posix-alpha-class-on-unicode",
      "dimension": "regex",
      "setup": {
        "local_boring": "^[[:alpha:]]+\\.tmp$\n"
      },
      "query": "\u00e9.tmp",
      "expected_boring": false,
      "native_status": "captured"
    },
    {
      "id": "darcs.posix-alpha-class-on-unicode-utf8-locale",
      "dimension": "locale",
      "setup": {
        "local_boring": "^[[:alpha:]]+\\.tmp$\n",
        "locale": "C.UTF-8"
      },
      "query": "\u00e9.tmp",
      "expected_boring": false,
      "native_status": "captured",
      "note": "The POSIX alpha class remains ASCII-only under C.UTF-8 in tested Darcs profiles."
    },
    {
      "id": "darcs.invalid-regex-is-ignored",
      "dimension": "lexing",
      "setup": {
        "local_boring": "invalid[\n"
      },
      "query": "invalid[",
      "expected_boring": false,
      "native_status": "captured",
      "note": "Darcs warns about and ignores an invalid ERE, leaving a matching filename as an add candidate."
    },
    {
      "id": "darcs.leading-space-pattern-matches-leading-space-name",
      "dimension": "lexing",
      "setup": {
        "local_boring": " #space\n",
        "files": {
          " #space": "ignored by the leading-space expression\n",
          " unignored": "remains an add candidate\n"
        }
      },
      "query": " unignored",
      "expected_boring": false,
      "native_status": "captured"
    }
  ]
}
